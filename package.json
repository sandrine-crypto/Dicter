{
  "name": "dicter",
  "version": "1.0.0",
  "description": "Lecteur vocal - French vocal reader web application",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "serve": "npx serve ."
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^23.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "text-to-speech",
    "vocal-reader",
    "accessibility",
    "french"
  ],
  "license": "MIT"
}
